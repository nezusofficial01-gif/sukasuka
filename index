function tryImg(path,alt,fail){const b=path.replace(/\.\w+$/,""),x=["jpg","png","jpeg","webp"];let k=0;const im=new Image();im.alt=alt;
im.onload=()=>{const q=im.parentNode;if(q&&q.classList&&q.classList.contains("imbox")){q.disabled=false;q.classList.add("zoom");q.setAttribute("aria-label","Perbesar: "+alt)}};
