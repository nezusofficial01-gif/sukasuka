/* Projects */
P.forEach((p,i)=>{p.n=String(i+1).padStart(2,"0");p.slug=p.img[0].match(/\d\d-([a-z0-9]+)-/)[1]});
const FL=[["all","All"],["work","Applied in Workplace"],["team","Team Project"],["academic","Academic Project"]];
$("#fl").innerHTML=FL.map(([f,l])=>`<button type="button" data-f="${f}" aria-pressed="false">${l}</button>`).join("");
let F="all",sel=null,lastV=null,first=true;
const vis=()=>P.filter(p=>F==="all"||p.k===F);
function renderProjects(){
 const arr=vis(),p=arr.find(x=>x.slug===sel)||arr[0];
 $("#pj").classList.toggle("has-sel",!!sel);
 $$("#fl button").forEach(b=>b.setAttribute("aria-pressed",String(b.dataset.f===F)));
 $("#pl").innerHTML=arr.map(x=>`<a class="it${x===p?" on":""}" href="#/projects/${x.slug}"${x===p?' aria-current="true"':""}><span class="n">PROJECT ${x.n}</span><br><b>${esc(x.t)}</b><small>${esc(x.d)}</small></a>`).join("");
 detail(p,arr);
}
function detail(p,arr){
 const s=p.s,ok=v=>v&&!/Belum ada data/.test([].concat(v).join(" "));
 const i=arr.indexOf(p),pv=arr[(i-1+arr.length)%arr.length],nx=arr[(i+1)%arr.length];
 const prob=[s["Background"],s["Objective"]].filter(ok);
 let h=`<a class="back" href="#/projects">&larr; Back to Projects</a><div><span class="bdg ${p.k}">${p.st}</span></div><h2 tabindex="-1">${esc(p.t)}</h2><p class="cat">Project ${p.n} / ${String(P.length).padStart(2,"0")} · ${esc(p.cat)}</p>`;
 h+=`<h3>Visual Documentation</h3><div class="gal"></div><h3>Project Overview</h3><p>${esc(s["Project Overview"])}</p>`;
 if(p.k==="team")h+=`<p class="note">Proyek tim. Bagian My Contribution menunjukkan kontribusi pribadi saya; hasil lain adalah milik tim.</p>`;
 if(prob.length)h+=`<h3>${p.slug==="dashboard"?"Scope":"Problem / Objective"}</h3>`+prob.map(x=>`<p>${esc(x)}</p>`).join("");
 h+=`<h3>My Contribution</h3><ul>${s["My Contribution"].map(x=>`<li>${esc(x)}</li>`).join("")}</ul><h3>Process &amp; Technical Approach</h3>`;
 if(ok(s["Engineering Approach"]))h+=`<p>${esc(s["Engineering Approach"])}</p>`;
 h+=`<p><b>Tools:</b> ${esc(s["Tools & Methods"])}</p>`;
 if(arr.length>1)h+=`<div class="pn"><a class="btn" href="#/projects/${pv.slug}" aria-label="Project sebelumnya: ${esc(pv.t)}">&larr; ${pv.n}</a><a class="btn" href="#/projects/${nx.slug}" aria-label="Project berikutnya: ${esc(nx.t)}">${nx.n} &rarr;</a></div>`;
 const d=$("#det");d.innerHTML=h;
 const g=d.querySelector(".gal");
 p.img.forEach((f,k)=>{const b=document.createElement("button");b.type="button";b.className="imbox";b.disabled=true;b.append(tryImg(f,p.t+", gambar "+(k+1),()=>ph(f)));g.append(b)});
 d.style.animation="none";void d.offsetWidth;d.style.animation="";
}
$("#fl").onclick=e=>{const b=e.target.closest("button");if(!b)return;F=b.dataset.f;
 if(sel&&!vis().some(p=>p.slug===sel)){location.hash="#/projects"}else renderProjects()};
/* Routing berbasis hash: #/overview, #/projects, #/projects/<slug> */
const V=N.map(n=>n[0]),LB=Object.fromEntries(N.map(n=>[n[0],n[1]]));
function route(){
 const [v0,sl]=(location.hash.replace(/^#\/?/,"")||"overview").split("/");
 const v=V.includes(v0)?v0:"overview";
 sel=v==="projects"&&P.some(p=>p.slug===sl)?sl:null;
 if(sel&&!vis().some(p=>p.slug===sel))F="all";
 $$(".view").forEach(e=>{e.hidden=e.id!=="v-"+v});
 $$("[data-v]").forEach(a=>a.dataset.v===v?a.setAttribute("aria-current","page"):a.removeAttribute("aria-current"));
 document.title=LB[v]+" — Nabil Alfahmi Labib";
 if(v==="projects")renderProjects();
 if(!first&&(v!==lastV||innerWidth<=1100)){window.scrollTo(0,0);const t=$("#v-"+v+(v==="projects"&&sel?" .det h2":" h1"));if(t)t.focus({preventScroll:true})}
 first=false;lastV=v;
}
addEventListener("hashchange",route);
/* Preview gambar */
const lb=$("#lb");let lbL=[],lbI=0;
const lbShow=()=>{const o=lbL[lbI];$("#lbi").src=o.src;$("#lbi").alt=o.alt;$("#lbt").textContent=o.alt;$("#lbn").textContent="GAMBAR "+(lbI+1)+" / "+lbL.length};
const lbGo=d=>{lbI=(lbI+d+lbL.length)%lbL.length;lbShow()};
$("#det").addEventListener("click",e=>{const b=e.target.closest(".imbox.zoom");if(!b)return;
 const all=[...$$("#det .imbox.zoom")];lbL=all.map(x=>({src:x.querySelector("img").src,alt:x.querySelector("img").alt}));lbI=all.indexOf(b);lbShow();lb.showModal()});
$("#lbp").onclick=()=>lbGo(-1);$("#lbx").onclick=()=>lbGo(1);$("#lbc").onclick=()=>lb.close();
lb.addEventListener("keydown",e=>{if(e.key==="ArrowRight")lbGo(1);if(e.key==="ArrowLeft")lbGo(-1)});
lb.addEventListener("click",e=>{if(e.target===lb)lb.close()});
route();
</script>
